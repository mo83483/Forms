# ═══════════════════════════════════════════════════════════════════
# AI Form Solver — متغيرات البيئة (انسخ إلى .env واملأ ما تريد)
# كل القيم اختيارية: التطبيق يعمل بدون أي منها (بالوضع التجريبي + Pollinations المجاني)
# ═══════════════════════════════════════════════════════════════════

# ── الجلسة (حدّها بسلسلة عشوائية طويلة في الإنتاج) ──
SESSION_SECRET=

# ── Google OAuth 2.0 — من Google Cloud Console → APIs & Services → Credentials ──
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
# الصلاحيات المطلوبة فقط: openid email profile — لا تطلب أي scope إضافي
GOOGLE_CLIENT_ID=862108721443-gu36794bvphl1l8rvmn6nrrco601q4oc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# الرابط العام للتطبيق (يُستخدم في روابط OAuth وإرجاع Google)
NEXTAUTH_URL=http://localhost:3000/api/auth/callback/google

# ── APInex (المزود الأساسي) — GPT-6 Luna ──
# من لوحة تحكم APInex. الخادم فقط — لا تضف بادئة NEXT_PUBLIC_ أبدًا.
# اتركه فارغًا = يتخطاه المحرك تلقائيًا ويستخدم الاحتياطي
APINEX_API_KEY=sk-apx812b26cdeb76fa63f94f0450b725783daabcc563f9b70c3
# اختياري — الافتراضي free/gpt-6-luna (لا تغيّره للإنتاج)
APINEX_MODEL=free/gpt-6-luna

# ── محركات AI الاحتياطية (اختياري — التطبيق يعمل بدونها) ──
# Gemini مجاني من https://aistudio.google.com/apikey — الحصة اليومية محدودة
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter — نماذج تحمل لاحقة :free — من https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Pollinations — مجاني بلا مفتاح إطلاقًا (الافتراضي عندما تغيب المفاتيح)
POLLINATIONS_MODEL=openai

# ── الأتمتة على الخادم (اختياري) ──
# بعد التثبيت نفّذ: npx playwright-core install chromium
# ملاحظة: التعبئة على الخادم تعمل للنماذج العامة فقط (بلا جلسة Google للمستخدم)
# المسار الأفضل دائمًا: «سكربت التعبئة المحلي» من لوحة التحكم
